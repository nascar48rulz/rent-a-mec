# Copy to .env on your production host and fill in real values.
# NEVER commit real keys to git.

PORT=3847
# Behind Caddy/nginx/Cloudflare the Node app speaks HTTP on localhost
HTTPS=0
NODE_ENV=production

# Must match the public URL users see (https://your-domain)
APP_URL=https://YOUR_DOMAIN

JWT_SECRET=generate-a-long-random-string-here

# Live Stripe keys from https://dashboard.stripe.com/apikeys
# Use sk_live_ / pk_live_ only after testing with sk_test_ / pk_test_
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME

# Optional: pin SQLite location on the server
# RAM_DB_PATH=/var/lib/rent-a-mec/rentamec.db
# RAM_DATA_DIR=/var/lib/rent-a-mec
